# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

.env
backend/.env

# Python
venv/
ai-service/venv/
__pycache__/
*.pyc

# AI training dataset — dev-time only, never read by the running app.
# NOTE: ai-service/models/*.keras is intentionally NOT ignored — the app
# loads those at runtime for prediction, so they must stay in the repo
# (or be swapped for Git LFS / a release asset later if they grow).
ai-service/dataset/

# Uploaded user content
backend/uploads/diseases/*
!backend/uploads/diseases/.gitkeep
